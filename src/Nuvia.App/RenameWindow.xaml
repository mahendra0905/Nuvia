<Window x:Class="Nuvia.App.RenameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename file (local label)"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Rename this file"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,8" />
        <TextBlock TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,14"
                   Text="This changes only the local display name Nuvia shows for the file. Nothing is sent to Telegram: the file in your Saved Messages, its caption and its original filename are all left unchanged." />

        <TextBlock Text="Display name" FontWeight="SemiBold" Margin="0,0,0,4"
                   Foreground="{StaticResource TextPrimaryBrush}" />
        <TextBox x:Name="NameBox"
                 MaxLength="255"
                 Padding="6,4"
                 FontSize="13"
                 TextChanged="NameBox_TextChanged" />
        <TextBlock x:Name="ValidationText"
                   Foreground="{StaticResource DangerTextBrush}"
                   FontSize="11"
                   Margin="0,4,0,0"
                   Visibility="Collapsed"
                   Text="Enter a name." />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="RenameButton"
                    Content="Rename"
                    IsDefault="True"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="96"
                    Click="RenameButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
