<Window x:Class="Nuvia.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuvia — Sign In"
        Width="900"
        Height="580"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        Icon="Assets\Nuvia.ico"
        KeyDown="Window_KeyDown">

    <Window.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Rounded field shared by the phone/code text boxes -->
        <Style x:Key="LoginTextBox" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Rounded field for the 2FA password box -->
        <Style x:Key="LoginPasswordBox" TargetType="PasswordBox">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="11,8" />
            <Setter Property="Margin" Value="0,7,0,0" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Full-width grass-green primary action -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
            <Setter Property="Background" Value="{StaticResource AccentBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="46" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Quiet text button for Cancel / Back -->
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.15*" />
            <ColumnDefinition Width="1*" />
        </Grid.ColumnDefinitions>
        <!-- ===================== LEFT: branding + illustration ===================== -->
        <Border Grid.Column="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#F1F8E9" Offset="0" />
                    <GradientStop Color="#E4F0D4" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <Grid Margin="40,34">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Logo + lowercase Segoe Script wordmark -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Top">
                    <Image Source="Assets/n-logo.png" Width="46" Height="46"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="nuvia" FontFamily="Segoe Script" FontSize="40"
                               Foreground="#A3E635" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <!-- Character illustration -->
                <Image Grid.Row="1" Source="Assets/login-illustration.png" Stretch="Uniform"
                       MaxHeight="330" Margin="0,18"
                       RenderOptions.BitmapScalingMode="HighQuality" />

                <!-- Tagline + required unofficial-app disclosure -->
                <StackPanel Grid.Row="2">
                    <TextBlock Text="The cloud that never fills up." FontSize="17"
                               Foreground="#4A5340" HorizontalAlignment="Center" />
                    <TextBlock TextWrapping="Wrap" TextAlignment="Center" FontSize="11.5"
                               Foreground="#7A8570" Margin="0,10,0,0">
                        Nuvia is an unofficial client — not affiliated with Telegram. Files are stored in your own Telegram account.
                    </TextBlock>
                </StackPanel>
            </Grid>
        </Border>
        <!-- ===================== RIGHT: Telegram sign-in ===================== -->
        <Border Grid.Column="1" Background="{StaticResource WindowBgBrush}">
            <Grid>
            <ScrollViewer x:Name="FormScroller" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
            <!-- MinHeight = viewport keeps the form vertically centred when it fits,
                 and lets it scroll once phone + code + 2FA are all on screen. -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=FormScroller}">
            <StackPanel x:Name="FormRoot" MaxWidth="360" VerticalAlignment="Center"
                        HorizontalAlignment="Stretch" Margin="24,28">

                <!-- Demo notice — shown only when the demo auth stand-in is active -->
                <Border x:Name="DemoNotice"
                        Visibility="Collapsed"
                        Background="{StaticResource AccentTintBrush}"
                        Padding="12,10"
                        CornerRadius="8"
                        BorderBrush="{StaticResource RowSelectedBorderBrush}"
                        BorderThickness="1"
                        Margin="0,0,0,16">
                    <TextBlock TextWrapping="Wrap" FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource TextPrimaryBrush}">
                        Demo login — no connection is made.
                    </TextBlock>
                </Border>

                <TextBlock Text="Welcome to Nuvia" FontSize="28" FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextPrimaryBrush}" />
                <TextBlock Text="Sign in with your Telegram account." FontSize="14"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0" />

                <!-- Progressive flow: each field reveals below the previous, on this one screen -->
                <StackPanel x:Name="PhoneFlowRoot" Margin="0,22,0,0">

                    <!-- ===== PHONE ENTRY PANEL ===== -->
                    <StackPanel x:Name="PhonePanel" Visibility="Visible">
                        <TextBlock Text="Phone number" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBox x:Name="PhoneTextBox"
                                 Style="{StaticResource LoginTextBox}"
                                 MaxLength="20"
                                 PreviewTextInput="PhoneTextBox_PreviewTextInput"
                                 TextChanged="PhoneTextBox_TextChanged"
                                 TabIndex="0" />
                        <TextBlock Text="We'll send a one-time login code to your Telegram app."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock x:Name="PhoneErrorText"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <!-- ===== CODE ENTRY PANEL (revealed after phone) ===== -->
                    <StackPanel x:Name="CodePanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Login code" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <TextBox x:Name="CodeTextBox"
                                 Style="{StaticResource LoginTextBox}"
                                 MaxLength="10"
                                 PreviewTextInput="CodeTextBox_PreviewTextInput"
                                 TextChanged="CodeTextBox_TextChanged"
                                 TabIndex="1" />
                        <TextBlock x:Name="CodeHint" Text="Enter the code sent to your Telegram app."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock x:Name="CodeErrorText"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <!-- Resend / SMS fallback — shown only when Telegram offers another delivery
                             medium; disabled with a live countdown until a resend is actually honoured. -->
                        <Button x:Name="ResendButton" Style="{StaticResource SecondaryButton}"
                                HorizontalAlignment="Left" Margin="0,4,0,0"
                                Visibility="Collapsed" Click="ResendButton_Click"
                                Content="Resend code" />
                    </StackPanel>

                    <!-- ===== PASSWORD (2FA) PANEL (revealed only if the account has 2FA) ===== -->
                    <StackPanel x:Name="PasswordPanel" Visibility="Collapsed" Margin="0,18,0,0">
                        <TextBlock Text="Two-factor password" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordBox}"
                                     MaxLength="128"
                                     PasswordChanged="PasswordBox_PasswordChanged"
                                     TabIndex="2" />
                        <TextBlock Text="This account has two-factor authentication enabled."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock x:Name="PasswordErrorText"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                    <!-- ===== INLINE BUSY (no full-screen takeover; the form stays visible) ===== -->
                    <StackPanel x:Name="BusyPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <ProgressBar IsIndeterminate="True" Height="3" BorderThickness="0"
                                     Foreground="{StaticResource AccentBrush}"
                                     Background="{StaticResource AccentTintBrush}" />
                        <TextBlock x:Name="BusyText" Text="Sending code…" FontSize="12.5"
                                   Foreground="{StaticResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0,8,0,0" />
                    </StackPanel>

                    <!-- ===== ACTIONS (contextual to the current step) ===== -->
                    <Button x:Name="PrimaryActionButton" Content="Send code"
                            Style="{StaticResource PrimaryButton}"
                            Click="PrimaryActionButton_Click" IsDefault="True" Margin="0,18,0,0" />
                    <Button x:Name="StartOverButton" Content="Start over"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="Collapsed" Click="StartOverButton_Click" />
                    <Button x:Name="CancelButton" Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Click="CancelButton_Click" />

                    <!-- Alternative sign-in: QR code. Shown only at the phone step and only when the
                         active auth service supports it (hidden in demo / unconfigured modes). -->
                    <StackPanel x:Name="QrEntryPanel" Visibility="Collapsed" Margin="0,14,0,0">
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" VerticalAlignment="Center"
                                    Background="{StaticResource DividerBrush}" />
                            <TextBlock Grid.Column="1" Text="or" Margin="10,0" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                            <Border Grid.Column="2" Height="1" VerticalAlignment="Center"
                                    Background="{StaticResource DividerBrush}" />
                        </Grid>
                        <Button x:Name="QrLoginButton" Content="Sign in with QR code"
                                Style="{StaticResource SecondaryButton}"
                                Click="QrLoginButton_Click" />
                    </StackPanel>
                </StackPanel>

                <!-- ===== QR SIGN-IN PANEL (alternative to the phone flow) ===== -->
                <StackPanel x:Name="QrFlowPanel" Visibility="Collapsed" Margin="0,22,0,0">
                    <TextBlock Text="Sign in with QR code" FontSize="20" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" FontSize="12.5"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0">
                        On your phone: Telegram → Settings → Devices → Link Desktop Device, then scan the code below.
                    </TextBlock>

                    <!-- White tile holding the QR image; a busy placeholder shows until it is drawn -->
                    <Border x:Name="QrTile" Margin="0,16,0,0" HorizontalAlignment="Center"
                            Background="#FFFFFF" CornerRadius="12"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            Padding="14" Width="240" Height="240">
                        <Grid>
                            <Image x:Name="QrImage" Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" />
                            <StackPanel x:Name="QrPlaceholder" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Height="3" Width="150" BorderThickness="0"
                                             Foreground="{StaticResource AccentBrush}"
                                             Background="{StaticResource AccentTintBrush}" />
                                <TextBlock Text="Preparing QR code…" FontSize="12.5"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,10,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="QrStatusText" Text="Preparing a secure QR code…"
                               FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0" />

                    <!-- QR 2FA sub-panel — revealed only if the account has a 2FA password -->
                    <StackPanel x:Name="QrPasswordPanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <TextBlock Text="Two-factor password" FontWeight="SemiBold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}" />
                        <PasswordBox x:Name="QrPasswordBox"
                                     Style="{StaticResource LoginPasswordBox}"
                                     MaxLength="128"
                                     PasswordChanged="QrPasswordBox_PasswordChanged" />
                        <TextBlock Text="This account has two-factor authentication enabled."
                                   FontSize="12.5" Foreground="{StaticResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" Margin="0,7,0,0" />
                        <TextBlock x:Name="QrPasswordError"
                                   Foreground="{StaticResource DangerBrush}" FontSize="12"
                                   Visibility="Collapsed" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button x:Name="QrPasswordSubmit" Content="Sign in"
                                Style="{StaticResource PrimaryButton}"
                                Click="QrPasswordSubmit_Click" Margin="0,14,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="QrErrorText"
                               Foreground="{StaticResource DangerBrush}" FontSize="12"
                               Visibility="Collapsed" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="0,12,0,0" />

                    <Button x:Name="QrRetryButton" Content="Show a fresh QR code"
                            Style="{StaticResource SecondaryButton}"
                            Visibility="Collapsed" Click="QrRetryButton_Click" />
                    <Button x:Name="QrBackButton" Content="Back to phone sign-in"
                            Style="{StaticResource SecondaryButton}"
                            Click="QrBackButton_Click" />
                </StackPanel>

            </StackPanel>
            </Grid>
            </ScrollViewer>

            <!-- Startup / configuration failures only — normal login errors show inline
                 under each field, never on this full-panel screen. -->
            <Border x:Name="ErrorPanel"
                    Visibility="Collapsed"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MaxWidth="360" Margin="24"
                    Background="#FFF5F5"
                    CornerRadius="8"
                    BorderBrush="#EF9A9A"
                    BorderThickness="1"
                    Padding="20">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="⚠" FontSize="34" HorizontalAlignment="Center" Margin="0,0,0,8" />
                    <TextBlock x:Name="ErrorMessageText"
                               FontSize="14" Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" TextAlignment="Center" Margin="0,0,0,16" />
                    <Button Content="Try again" Style="{StaticResource PrimaryButton}"
                            Click="RetryButton_Click" HorizontalAlignment="Center" MinWidth="150" />
                </StackPanel>
            </Border>
            </Grid>
        </Border>
    </Grid>

</Window>
