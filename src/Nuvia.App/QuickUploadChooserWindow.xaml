<Window x:Class="Nuvia.App.QuickUploadChooserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuvia — Upload"
        Width="420"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="True"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20">
        <TextBlock Text="Upload to Nuvia"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   Margin="0,0,0,4" />
        <TextBlock x:Name="FileText"
                   TextWrapping="Wrap"
                   TextTrimming="CharacterEllipsis"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,14"
                   Text="Choose where to store this file." />

        <Button x:Name="SavedButton"
                Content="Save to Saved Messages"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,9"
                Margin="0,0,0,8"
                Click="SavedButton_Click" />

        <Button x:Name="GroupButton"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,9"
                Margin="0,0,0,8"
                Visibility="Collapsed"
                Click="GroupButton_Click" />

        <Button x:Name="CreateButton"
                Content="Create a new private group…"
                Style="{StaticResource SecondaryButton}"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center"
                Padding="12,9"
                Margin="0,0,0,4"
                Visibility="Collapsed"
                Click="CreateButton_Click" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,14,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="96"
                    Click="CancelButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
