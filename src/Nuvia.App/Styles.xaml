<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===================== Nuvia design system =====================
         Clean modern light theme with a light grass-green accent.
         Palette + reusable styles live here. The keyed styles are opt-in, so
         only the main window adopts the new look for now; other windows keep
         their current appearance until they are restyled in a later step. -->

    <!-- Palette -->
    <SolidColorBrush x:Key="AccentBrush" Color="#7CB342" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6BA233" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#5A9128" />
    <SolidColorBrush x:Key="AccentTintBrush" Color="#F1F8E9" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#F3F8EC" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#E4F0D4" />
    <SolidColorBrush x:Key="RowSelectedBorderBrush" Color="#C5E1A5" />
    <SolidColorBrush x:Key="WindowBgBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="StripBrush" Color="#F7F9F5" />
    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#E7EAE3" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2419" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#6B7280" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#C62828" />

    <!-- Base font defaults (kept close to the originals so other windows are unchanged) -->
    <Style TargetType="{x:Type Window}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{StaticResource WindowBgBrush}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe UI" />
    </Style>

    <Style TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="Padding" Value="10,5" />
    </Style>

    <!-- Crisp vector icon font (Segoe Fluent Icons on Win11, MDL2 fallback on Win10) -->
    <Style x:Key="IconFont" TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
    </Style>

    <!-- Flat toolbar button: transparent, rounded, grass-green tint on hover -->
    <Style x:Key="ToolbarButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Margin" Value="1,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <!-- Content is centred by default (nav arrows, refresh, search). A button that sets
             HorizontalContentAlignment="Left" (e.g. the "New group…" row) is honoured because the
             ContentPresenter below template-binds to it instead of hardcoding Center. -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Accent primary button (available for later screens) -->
    <Style x:Key="PrimaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource OnAccentBrush}" />
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Neutral secondary button: white surface, subtle divider border, grass-green tint on hover.
         Pairs with PrimaryButton for a Nuvia-themed dialog (e.g. the transfer window's Cancel). -->
    <Style x:Key="SecondaryButton" TargetType="{x:Type Button}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="Padding" Value="16,8" />
        <Setter Property="MinWidth" Value="90" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                            CornerRadius="6" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentTintBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource RowSelectedBorderBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bd" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rounded search / text input -->
    <Style x:Key="SearchTextBox" TargetType="{x:Type TextBox}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="#FFFFFF" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Flat, left-aligned column header (keeps resize + reorder) -->
    <Style TargetType="{x:Type GridViewColumnHeader}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <!-- Full-row list items with grass-green hover/selection, dark readable text -->
    <Style TargetType="{x:Type ListViewItem}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="6,5" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <GridViewRowPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== File Explorer-style views (UI-3): large-icon tiles + left nav ===== -->

    <!-- Panel that lays icon tiles out left-to-right, wrapping like Explorer's large-icons view -->
    <ItemsPanelTemplate x:Key="FileTilePanel">
        <WrapPanel Orientation="Horizontal" />
    </ItemsPanelTemplate>

    <!-- One large-icon tile. Documents show a type glyph + short label (TXT/PDF/MP4/ZIP…); image files
         swap that card for a real cached preview once it has downloaded. Both occupy the same 132x78 slot,
         toggled by the row's GlyphVisibility / ThumbnailVisibility, so the tile never changes size. -->
    <DataTemplate x:Key="FileTileTemplate">
        <StackPanel Width="132" Margin="6,8">
            <Grid Width="132" Height="78" HorizontalAlignment="Center">
                <!-- Type glyph with a short upper-case label beneath it (empty label for images). -->
                <Border CornerRadius="8" Background="{StaticResource AccentTintBrush}"
                        Visibility="{Binding GlyphVisibility}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconFont}" Text="{Binding IconGlyph}" FontSize="34"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="{Binding TypeLabel}" FontSize="10" FontWeight="SemiBold"
                                   Margin="0,3,0,0" HorizontalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}" />
                    </StackPanel>
                </Border>
                <!-- Real image preview (downloaded once, cached on disk). The Border's rounded corners clip
                     the brush, so the thumbnail keeps the same card shape as the glyph it replaces. -->
                <Border CornerRadius="8" Visibility="{Binding ThumbnailVisibility}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
                <!-- Small "play" badge over a video's poster frame (videos only), so a video preview reads as
                     a video at a glance instead of looking like a still photo. Hidden for images. -->
                <Border Visibility="{Binding VideoBadgeVisibility}"
                        HorizontalAlignment="Left" VerticalAlignment="Bottom"
                        Margin="5" Width="22" Height="22" CornerRadius="11"
                        Background="#B3000000">
                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE768;" FontSize="11"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" TextAlignment="Center"
                       MaxHeight="36" TextTrimming="CharacterEllipsis" Margin="0,7,0,0"
                       Foreground="{StaticResource TextPrimaryBrush}" />
            <TextBlock Text="{Binding SizeDisplay}" TextAlignment="Center" FontSize="11" Margin="0,2,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </StackPanel>
    </DataTemplate>

    <!-- Tile container. The implicit ListViewItem style above draws a GridViewRowPresenter (for
         columns), so the grid view needs this ContentPresenter-based container instead, keeping the
         grass-green hover/selection. -->
    <Style x:Key="FileTileContainer" TargetType="{x:Type ListViewItem}">
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListViewItem}">
                    <Border x:Name="bd" Background="{TemplateBinding Background}"
                            BorderBrush="Transparent" BorderThickness="1"
                            CornerRadius="8" Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                            <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource RowSelectedBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Left navigation (Locations) item, Windows 11 Explorer style: rounded pill on
         hover/selection plus a rounded accent bar on the left edge when selected. -->
    <Style x:Key="NavItemContainer" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="Margin" Value="6,1" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <!-- Win11 selection accent bar (hidden unless selected) -->
                        <Rectangle x:Name="accent" Width="3" Height="18"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" VerticalAlignment="Center"
                                   Fill="{StaticResource AccentBrush}" Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bd" Property="Background" Value="{StaticResource RowSelectedBrush}" />
                            <Setter TargetName="accent" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin, non-interactive divider used between nav sections (e.g. Home | locations) -->
    <Style x:Key="NavSeparator" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Border Height="1" Margin="14,7"
                            Background="{StaticResource DividerBrush}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status bar -->
    <Style TargetType="{x:Type StatusBar}">
        <Setter Property="FontFamily" Value="Segoe UI" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Background" Value="{StaticResource StripBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

</ResourceDictionary>
