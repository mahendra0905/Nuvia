<Window x:Class="Nuvia.App.TransferProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuvia"
        Width="430"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Opacity="0"
        Background="{StaticResource WindowBgBrush}">
    <!-- Fade the window in when it opens; the owner fades it out via ForceClose() before it closes. -->
    <Window.Triggers>
        <EventTrigger RoutedEvent="Window.Loaded">
            <BeginStoryboard>
                <Storyboard>
                    <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                     From="0" To="1" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction>
                            <QuadraticEase EasingMode="EaseOut" />
                        </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                </Storyboard>
            </BeginStoryboard>
        </EventTrigger>
    </Window.Triggers>
    <!-- A separate, Windows Explorer-style copy dialog: opens on its own while a transfer runs,
         instead of an inline strip inside the main window. Nuvia's grass-green accent is kept. -->
    <Border Padding="20,18">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="HeaderIcon" Style="{StaticResource IconFont}" FontSize="18"
                           Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0"
                           Text="&#xE898;" />
                <TextBlock x:Name="HeaderText" FontSize="15" FontWeight="SemiBold"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextPrimaryBrush}" Text="Preparing…" />
            </StackPanel>

            <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="1" Margin="0,14,0,0"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource StripBrush}" BorderThickness="0" />

            <TextBlock x:Name="DetailText" FontSize="12" Margin="0,8,0,0"
                       Foreground="{StaticResource TextSecondaryBrush}" Text="Starting…" />

            <Border x:Name="FloodPanel" Visibility="Collapsed" Margin="0,10,0,0"
                    Background="{StaticResource AccentTintBrush}" CornerRadius="6" Padding="10,7">
                <TextBlock x:Name="FloodText" TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextPrimaryBrush}" />
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button x:Name="PauseButton" HorizontalAlignment="Right"
                        Style="{StaticResource PrimaryButton}" MinWidth="104" Margin="0,0,8,0"
                        Click="PauseButton_Click"
                        ToolTip="Pause the current transfer">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseIcon" Style="{StaticResource IconFont}"
                                   Foreground="{StaticResource OnAccentBrush}"
                                   Text="&#xE769;" Margin="0,0,6,0" />
                        <TextBlock x:Name="PauseLabel" Text="Pause" VerticalAlignment="Center"
                                   Foreground="{StaticResource OnAccentBrush}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CancelButton" Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        Click="CancelButton_Click"
                        ToolTip="Stop the current transfer" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
