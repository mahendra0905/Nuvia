<Window x:Class="Nuvia.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuvia"
        Width="380"
        Height="230"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="Transparent"
        AllowsTransparency="True"
        Icon="Assets\Nuvia.ico">

    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource DividerBrush}"
            BorderThickness="1"
            CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <!-- Brand lockup: logo + lowercase Segoe Script wordmark (matches the login page) -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Image Source="Assets/n-logo.png" Width="40" Height="40"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="nuvia"
                               FontFamily="Segoe Script"
                               FontSize="34"
                               Foreground="{StaticResource WordmarkBrush}"
                               VerticalAlignment="Center"
                               Margin="10,0,0,0" />
                </StackPanel>
                <TextBlock Text="The cloud that never fills up."
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,12,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock Text="Restoring your session…"
                           FontFamily="Segoe UI"
                           FontSize="12.5"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <ProgressBar Grid.Row="1"
                         IsIndeterminate="True"
                         Height="4"
                         Margin="24,0,24,24"
                         BorderThickness="0" />
        </Grid>
    </Border>
</Window>
