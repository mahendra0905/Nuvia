<Window x:Class="Nuvia.App.TransferSummaryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nuvia"
        Width="480"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <!-- End-of-batch summary: shown only when some files had problems. A clean batch never opens this. -->
    <Border Padding="20,18">
        <StackPanel>
            <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"
                       Foreground="{StaticResource TextPrimaryBrush}" Text="Finished with issues" />
            <TextBlock x:Name="SummaryText" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <Border Margin="0,14,0,0" CornerRadius="6" BorderThickness="1"
                    Background="{StaticResource StripBrush}"
                    BorderBrush="{StaticResource DividerBrush}">
                <ScrollViewer MaxHeight="260" VerticalScrollBarVisibility="Auto" Padding="4">
                    <ItemsControl x:Name="ProblemList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,6">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" FontSize="11"
                                               Margin="0,2,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <Button x:Name="CloseButton" Content="Close" HorizontalAlignment="Right" MinWidth="96"
                    Style="{StaticResource PrimaryButton}" Margin="0,16,0,0"
                    IsDefault="True" IsCancel="True" Click="CloseButton_Click" />
        </StackPanel>
    </Border>
</Window>
