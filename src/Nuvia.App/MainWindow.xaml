<Window x:Class="Nuvia.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nuvia.App"
        Title="Nuvia"
        Width="1100"
        Height="720"
        MinWidth="900"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBgBrush}"
        PreviewKeyDown="Window_PreviewKeyDown"
        Icon="Assets\Nuvia.ico">

    <Window.Resources>
        <!-- Shared right-click menus. x:Shared="False" gives every host its own instance, so one menu
             definition can be attached to several elements without a "logical parent" clash. Because each
             host gets its own instance, items that need per-open state (e.g. "Move to folder") must NOT be
             x:Named — they are found by Tag inside the menu's Opened handler. -->
        <ContextMenu x:Key="FileItemContextMenu" x:Shared="False" Opened="FileItemContextMenu_Opened">
            <MenuItem Header="Rename (local label)" Click="RenameButton_Click" />
            <!-- Submenu of folders is rebuilt per open in FileItemContextMenu_Opened (found by Tag). -->
            <MenuItem Header="Move to folder" Tag="MoveToFolder" />
            <MenuItem Header="Delete…" Click="DeleteButton_Click" />
        </ContextMenu>

        <!-- Folder tile right-click menu. "Delete folder…" is greyed out (with a reason) by
             FolderTileContextMenu_Opened when the folder tree still holds files, so a delete can never
             orphan a file row. The acted-on folder is read from the menu's PlacementTarget.DataContext. -->
        <ContextMenu x:Key="FolderTileContextMenu" x:Shared="False" Opened="FolderTileContextMenu_Opened">
            <MenuItem Header="Rename…" Tag="RenameFolder" Click="RenameFolderMenuItem_Click" />
            <MenuItem Header="Delete folder…" Tag="DeleteFolder" Click="DeleteFolderMenuItem_Click" />
        </ContextMenu>

        <!-- Empty-space / file-area menu (Explorer-style): "New folder…" (inside the open location),
             "New group…", Upload and Refresh. Folders are a Nuvia-local layer inside one location (Saved
             Messages or a managed group); "New folder…" is therefore greyed on Home / All files — which span
             every location and so have no single place to create a folder — by FileAreaContextMenu_Opened.
             Creating a group stays one-per-action: StartCreateGroupAsync is the single entry point. -->
        <ContextMenu x:Key="FileAreaContextMenu" x:Shared="False" Opened="FileAreaContextMenu_Opened">
            <MenuItem Header="New folder…" Tag="NewFolder" Click="NewFolderMenuItem_Click" />
            <MenuItem Header="New group…" Click="NewGroupMenuItem_Click" />
            <Separator />
            <MenuItem Header="Upload files…" Click="UploadButton_Click" />
            <MenuItem Header="Refresh" Click="RefreshButton_Click" />
        </ContextMenu>

        <!-- Shows a notification's action button only when it carries a URL + label (NotificationItem.HasAction). -->
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <!-- Root: app shell (DockPanel) + full-window Settings page -->
    <Grid>
    <DockPanel LastChildFill="True">

        <!-- Address + navigation bar (Explorer-style): back/forward/up/refresh · breadcrumb · search -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource WindowBgBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,5">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="NavBackButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            MinHeight="0" Padding="8,4" Click="NavBack_Click" ToolTip="Back">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE76B;" FontSize="16" />
                    </Button>
                    <Button x:Name="NavForwardButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            MinHeight="0" Padding="8,4" Click="NavForward_Click" ToolTip="Forward">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE76C;" FontSize="16" />
                    </Button>
                    <Button x:Name="NavUpButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            MinHeight="0" Padding="8,4" Click="NavUp_Click" ToolTip="Up to Home">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE70E;" FontSize="16" />
                    </Button>
                    <Button x:Name="RefreshButton" Style="{StaticResource ToolbarButton}"
                            MinHeight="0" Padding="8,4" Click="RefreshButton_Click"
                            ToolTip="Reload the local index list (F5). This only re-reads Nuvia's local database — it does not import files from your Telegram history.">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE895;" FontSize="14" />
                    </Button>
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,4" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Width="300" VerticalAlignment="Center"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                        CornerRadius="6" Background="#FFFFFF" Padding="8,0" Margin="10,0,0,0">
                    <DockPanel>
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE721;" DockPanel.Dock="Left"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="2,0,6,0" VerticalAlignment="Center" />
                        <Button x:Name="ClearSearchButton" DockPanel.Dock="Right"
                                Style="{StaticResource ToolbarButton}" IsEnabled="False"
                                Click="ClearSearchButton_Click" MinHeight="0" Padding="6,2" ToolTip="Clear search">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE711;" FontSize="12" />
                        </Button>
                        <Grid>
                            <TextBox x:Name="SearchBox" BorderThickness="0" Background="Transparent"
                                     VerticalContentAlignment="Center" Padding="0,4"
                                     TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                            <TextBlock x:Name="SearchPlaceholder" Text="Search Nuvia" IsHitTestVisible="False"
                                       VerticalAlignment="Center" Margin="2,0,0,0"
                                       Foreground="{StaticResource TextSecondaryBrush}" />
                        </Grid>
                    </DockPanel>
                </Border>
                <Border BorderBrush="{StaticResource DividerBrush}" BorderThickness="1" CornerRadius="6"
                        Background="#FFFFFF" Padding="10,0" VerticalAlignment="Center" Height="30">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE80F;" FontSize="14"
                                   Foreground="{StaticResource AccentBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <Button x:Name="BreadcrumbRootButton" Style="{StaticResource LinkButton}"
                                Content="Nuvia" Click="BreadcrumbRoot_Click" MinHeight="0" Padding="0"
                                ToolTip="Go to Home" />
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10"
                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="7,1,7,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="LocationHeaderText" Text="Home" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <!-- One "› folder" link per open folder segment, rebuilt in RebuildBreadcrumb. Empty
                             at the location root; the location name above stays as the location's own crumb. -->
                        <StackPanel x:Name="BreadcrumbFolders" Orientation="Horizontal" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Command bar: actions + Sort/View on the left, account on the right -->
        <Border DockPanel.Dock="Top"
                Background="{StaticResource StripBrush}"
                BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,7">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <!-- Notifications (bell). Badge = small danger dot shown only while something is unread.
                         The popup is the notification center; it opens below the bell and extends leftward. -->
                    <Grid Margin="0,0,6,0">
                        <Button x:Name="NotificationsButton"
                                Style="{StaticResource ToolbarButton}"
                                Click="NotificationsButton_Click"
                                ToolTip="Notifications">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xEA8F;" />
                        </Button>
                        <Ellipse x:Name="NotificationBadge"
                                 Width="9" Height="9"
                                 Fill="{StaticResource DangerBrush}"
                                 Stroke="{StaticResource StripBrush}" StrokeThickness="1.5"
                                 HorizontalAlignment="Right" VerticalAlignment="Top"
                                 Margin="0,5,5,0"
                                 IsHitTestVisible="False"
                                 Visibility="Collapsed" />
                        <Popup x:Name="NotificationsPopup"
                               PlacementTarget="{Binding ElementName=NotificationsButton}"
                               Placement="Bottom"
                               HorizontalOffset="-316"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Fade">
                            <!-- UseLayoutRounding + Display-mode text keep small popup text crisp at
                                 fractional DPI. The drop shadow sits on its OWN layer (below) so the
                                 content Border carries no Effect — an Effect anywhere in the text's
                                 visual ancestry forces grayscale AA and makes text look blurry/low-res. -->
                            <Grid Margin="0,6,10,10" UseLayoutRounding="True"
                                  TextOptions.TextFormattingMode="Display"
                                  TextOptions.TextRenderingMode="ClearType"
                                  RenderOptions.ClearTypeHint="Enabled">
                                <!-- Shadow-only layer: carries the effect, holds no text. -->
                                <Border Background="{StaticResource CardBrush}"
                                        CornerRadius="{StaticResource RadiusMedium}" Width="360">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.22" Color="#000000" />
                                    </Border.Effect>
                                </Border>
                                <!-- Content layer: no Effect, so ClearType stays on and the text is sharp. -->
                                <Border Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource DividerBrush}"
                                        BorderThickness="1"
                                        CornerRadius="{StaticResource RadiusMedium}" Width="360">
                                <DockPanel>
                                    <Grid DockPanel.Dock="Top" Margin="14,12,10,8">
                                        <TextBlock Text="Notifications" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="MarkAllReadButton"
                                                Style="{StaticResource LinkButton}"
                                                Content="Mark all read"
                                                HorizontalAlignment="Right"
                                                Click="MarkAllNotificationsRead_Click" />
                                    </Grid>
                                    <Grid>
                                        <ScrollViewer x:Name="NotificationsScroller"
                                                      MaxHeight="420" VerticalScrollBarVisibility="Auto"
                                                      Visibility="Collapsed">
                                            <ItemsControl x:Name="NotificationsList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Padding="14,10"
                                                                BorderBrush="{StaticResource DividerBrush}"
                                                                BorderThickness="0,1,0,0">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource IconFont}"
                                                                           Text="{Binding Glyph}"
                                                                           Foreground="{StaticResource AccentBrush}"
                                                                           Margin="0,2,10,0" VerticalAlignment="Top" />
                                                                <StackPanel Width="286">
                                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"
                                                                               TextWrapping="Wrap"
                                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                                                               FontSize="12" Margin="0,2,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <TextBlock Text="{Binding RelativeTime}" FontSize="11"
                                                                               Margin="0,4,0,0"
                                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                                    <Button Content="{Binding ActionLabel}"
                                                                            Style="{StaticResource LinkButton}"
                                                                            HorizontalAlignment="Left" Margin="0,6,0,0"
                                                                            Tag="{Binding ActionUrl}"
                                                                            Click="NotificationAction_Click"
                                                                            Visibility="{Binding HasAction, Converter={StaticResource BoolToVisibility}}" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock x:Name="NotificationsEmpty"
                                                   Text="You're all caught up."
                                                   Margin="14,10,14,18"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" />
                                    </Grid>
                                </DockPanel>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <Button x:Name="SettingsButton"
                            Style="{StaticResource ToolbarButton}"
                            Click="SettingsMenuItem_Click" Margin="0,0,6,0"
                            ToolTip="Settings">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE713;" />
                    </Button>
                    <Button x:Name="AccountChip"
                            Style="{StaticResource ToolbarButton}"
                            Click="AccountChip_Click"
                            ToolTip="Account and log out">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE77B;" Margin="0,0,7,0" />
                            <TextBlock x:Name="AccountChipText" Text="Account" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE70D;" FontSize="11" Margin="7,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="AccountLabelItem" Header="Signed in" IsEnabled="False" />
                                <Separator />
                                <MenuItem Header="Log out and delete local session…" Click="LogoutMenuItem_Click" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="UploadButton" Style="{StaticResource PrimaryButton}" IsEnabled="False"
                            Margin="1,0,6,0" Click="UploadButton_Click"
                            ToolTip="Upload files to your Telegram Saved Messages (pick one or several)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE898;"
                                       Foreground="{StaticResource OnAccentBrush}" Margin="0,0,7,0" />
                            <TextBlock Text="Upload" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DownloadButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            Click="DownloadButton_Click"
                            ToolTip="Select one or more files first, then download them">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE896;" Margin="0,0,7,0" />
                            <TextBlock Text="Download" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="RenameButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            Click="RenameButton_Click"
                            ToolTip="Rename the selected file's local label (F2). Only Nuvia's display name changes — your Telegram file is untouched.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE70F;" Margin="0,0,7,0" />
                            <TextBlock Text="Rename" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="DeleteButton" Style="{StaticResource ToolbarButton}" IsEnabled="False"
                            Click="DeleteButton_Click"
                            ToolTip="Delete the selected file(s) (Del). Choose to remove them from Nuvia only, or delete them from Telegram too.">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,0,7,0" />
                            <TextBlock Text="Delete" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,4" />
                    <Button x:Name="SortMenuButton" Style="{StaticResource ToolbarButton}"
                            Click="SortMenuButton_Click" ToolTip="Sort the list">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE8CB;" Margin="0,0,7,0" />
                            <TextBlock Text="Sort" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE70D;" FontSize="11" Margin="7,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="SortByNameItem" Header="Name" IsCheckable="True"
                                          Click="SortMenuItem_Click" Tag="Name" />
                                <MenuItem x:Name="SortBySizeItem" Header="Size" IsCheckable="True"
                                          Click="SortMenuItem_Click" Tag="Size" />
                                <MenuItem x:Name="SortByDateItem" Header="Date uploaded" IsCheckable="True"
                                          IsChecked="True" Click="SortMenuItem_Click" Tag="Uploaded" />
                                <Separator />
                                <MenuItem x:Name="SortAscItem" Header="Ascending" IsCheckable="True"
                                          Click="SortDirItem_Click" Tag="Asc" />
                                <MenuItem x:Name="SortDescItem" Header="Descending" IsCheckable="True"
                                          IsChecked="True" Click="SortDirItem_Click" Tag="Desc" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Button x:Name="ViewMenuButton" Style="{StaticResource ToolbarButton}"
                            Click="ViewMenuButton_Click" ToolTip="Change how files are shown">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE8A9;" Margin="0,0,7,0" />
                            <TextBlock Text="View" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE70D;" FontSize="11" Margin="7,0,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem x:Name="ViewLargeIconsItem" Header="Large icons" IsCheckable="True"
                                          IsChecked="True" Click="ViewModeItem_Click" Tag="Grid" />
                                <MenuItem x:Name="ViewDetailsItem" Header="Details" IsCheckable="True"
                                          Click="ViewModeItem_Click" Tag="Details" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- (Address + navigation bar is rendered above the command bar, at the top of the window.) -->


        <!-- Transfer progress is now shown in a separate Windows-style window (TransferProgressWindow),
             opened while a transfer runs — there is no inline transfer strip here anymore. -->

        <!-- Status bar: file count (left); upload target + index + view toggles (right) -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <DockPanel HorizontalAlignment="Stretch" LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>
            <StatusBarItem DockPanel.Dock="Left">
                <TextBlock x:Name="StatusText" Text="Ready" TextTrimming="CharacterEllipsis" />
            </StatusBarItem>
            <StatusBarItem x:Name="FloodWaitItem" DockPanel.Dock="Left" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE823;" FontSize="13"
                               Margin="10,0,5,0" Foreground="{StaticResource DangerBrush}" />
                    <TextBlock x:Name="FloodWaitText" Foreground="{StaticResource DangerBrush}" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem DockPanel.Dock="Right">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="UploadTargetText" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="  ·  " Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="IndexPathText" Foreground="{StaticResource TextSecondaryBrush}"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260" />
                    <Button x:Name="OpenIndexButton" Style="{StaticResource ToolbarButton}"
                            Click="OpenIndexFolder_Click" MinHeight="0" Padding="8,2" Margin="6,0,0,0"
                            ToolTip="Open the folder that holds Nuvia's local index">
                        <TextBlock Text="Open" />
                    </Button>
                    <Border Width="1" Background="{StaticResource DividerBrush}" Margin="8,2" />
                    <Button x:Name="GridViewToggle" Style="{StaticResource ToolbarButton}"
                            Click="GridViewToggle_Click" MinHeight="0" Padding="8,2"
                            ToolTip="Large icons">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="14" />
                    </Button>
                    <Button x:Name="DetailsViewToggle" Style="{StaticResource ToolbarButton}"
                            Click="DetailsViewToggle_Click" MinHeight="0" Padding="8,2" Margin="2,0,0,0"
                            ToolTip="Details">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE8A1;" FontSize="14" />
                    </Button>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>
        <!-- Content area (fill): left Locations pane | splitter | file views; overlays render on top -->
        <Grid Background="{StaticResource WindowBgBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="NavColumn" Width="210" MinWidth="150" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!-- Left: Locations navigation pane (Windows 11 Explorer style; filters the list, view-only) -->
                <Border Grid.Column="0" Background="{StaticResource StripBrush}"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <ListBox x:Name="LocationsList" DockPanel.Dock="Top" BorderThickness="0" Background="Transparent"
                                 Margin="0,10,0,0"
                                 ItemContainerStyle="{StaticResource NavItemContainer}"
                                 SelectionChanged="LocationsList_SelectionChanged">
                            <ListBoxItem x:Name="LocationHomeItem" IsSelected="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE80F;" Margin="0,0,12,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Home" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem Style="{StaticResource NavSeparator}" />
                            <ListBoxItem x:Name="LocationAllItem">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE8B7;" Margin="0,0,12,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="All files" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <ListBoxItem x:Name="LocationSavedItem">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE77B;" Margin="0,0,12,0"
                                               Foreground="{StaticResource AccentBrush}" />
                                    <TextBlock Text="Saved Messages" VerticalAlignment="Center" />
                                </StackPanel>
                            </ListBoxItem>
                            <!-- One selectable node per managed group is inserted here at runtime,
                                 right after Saved Messages (see RebuildGroupNodes). -->
                        </ListBox>

                        <!-- Create another private storage group (an account may keep as many as Telegram allows). -->
                        <Button x:Name="NewGroupButton" DockPanel.Dock="Top" Style="{StaticResource ToolbarButton}"
                                HorizontalContentAlignment="Left" Margin="6,2" Padding="12,9"
                                Click="NewGroupMenuItem_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,12,0"
                                           Foreground="{StaticResource AccentBrush}" />
                                <TextBlock Text="New group…" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Border DockPanel.Dock="Top" Height="1" Margin="14,8"
                                Background="{StaticResource DividerBrush}" />
                        <TextBlock DockPanel.Dock="Top" Text="STORAGE" Margin="18,4,12,6"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Storage overview: real per-type counts + sizes from the local index; click to filter by type. -->
                        <ListBox x:Name="CategoriesList" BorderThickness="0" Background="Transparent"
                                 Margin="0,0,0,8"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="CategoriesList_SelectionChanged"
                                 PreviewMouseLeftButtonDown="CategoriesList_PreviewMouseDown">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource NavItemContainer}">
                                    <Setter Property="Visibility" Value="{Binding RowVisibility}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel LastChildFill="True">
                                        <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8"
                                                Background="{StaticResource AccentTintBrush}" Margin="0,0,12,0">
                                            <TextBlock Style="{StaticResource IconFont}" Text="{Binding Glyph}"
                                                       FontSize="17" Foreground="{StaticResource AccentBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding SizeDisplay}"
                                                   VerticalAlignment="Center" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}" Margin="8,0,0,0" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="{Binding CountDisplay}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"
                                                       Margin="0,1,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter x:Name="NavSplitter" Grid.Column="1" Width="4"
                              HorizontalAlignment="Center" VerticalAlignment="Stretch"
                              Background="Transparent" ResizeBehavior="PreviousAndNext" />
                <!-- Right: file views + empty state (stacked; visibility controlled in code-behind).
                     The whole area accepts files dragged in from Explorer, for upload. -->
                <Grid Grid.Column="2" AllowDrop="True" Background="Transparent"
                      ContextMenu="{StaticResource FileAreaContextMenu}"
                      DragEnter="FileArea_DragOver" DragOver="FileArea_DragOver"
                      DragLeave="FileArea_DragLeave" Drop="FileArea_Drop">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Folder strip: the child folders of the current level, Explorer-style, above the file
                         views so it reads the same in both large-icons and details mode. Only shown inside a
                         single location (Saved Messages / a group) that has at least one child folder here;
                         filled and toggled in RebuildFolderStrip. Double-click a tile to open it. -->
                    <Border Grid.Row="0" x:Name="FolderStripBorder" Visibility="Collapsed"
                            Padding="8,8,8,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="188"
                                      HorizontalScrollBarVisibility="Disabled">
                            <ItemsControl x:Name="FolderStrip">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="156" Height="56" Margin="6" CornerRadius="8"
                                                Background="{StaticResource AccentTintBrush}"
                                                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1"
                                                ContextMenu="{StaticResource FolderTileContextMenu}"
                                                MouseLeftButtonDown="FolderTile_MouseDown"
                                                Cursor="Hand" ToolTip="{Binding Name}">
                                            <DockPanel LastChildFill="True" Margin="10,0">
                                                <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8"
                                                        Background="#FFFFFF" Margin="0,0,10,0">
                                                    <TextBlock Style="{StaticResource IconFont}" Text="&#xE8B7;"
                                                               FontSize="18" Foreground="{StaticResource AccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource TextPrimaryBrush}" />
                                                    <TextBlock Text="{Binding ItemCountDisplay}" FontSize="11"
                                                               Foreground="{StaticResource TextSecondaryBrush}"
                                                               Margin="0,1,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>

                    <!-- File views + empty state + drop overlay (stacked; visibility controlled in code). -->
                    <Grid Grid.Row="1">
                    <StackPanel x:Name="EmptyStatePanel" Visibility="Collapsed"
                                HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                        <Border Width="72" Height="72" CornerRadius="36"
                                Background="{StaticResource AccentTintBrush}"
                                HorizontalAlignment="Center" Margin="0,0,0,16">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE8B7;" FontSize="34"
                                       Foreground="{StaticResource AccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="EmptyStateTitle" Text="No files yet"
                                   FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6" />
                        <TextBlock x:Name="EmptyStateBody"
                                   Text="Upload a file to store it privately in your Telegram account."
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>

                    <!-- Details view (columns) -->
                    <ListView x:Name="FileListView" Visibility="Collapsed"
                              BorderThickness="0" Background="Transparent"
                              SelectionMode="Extended"
                              SelectionChanged="FileListView_SelectionChanged"
                              PreviewMouseRightButtonDown="FileView_PreviewMouseRightButtonDown"
                              ContextMenu="{StaticResource FileAreaContextMenu}"
                              GridViewColumnHeader.Click="FileDetailsHeader_Click"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <!-- Keep the themed row look (implicit ListViewItem style) and add the per-file menu. -->
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="ContextMenu" Value="{StaticResource FileItemContextMenu}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" Width="360">
                                    <!-- Name cell = per-file-type glyph + the file name, reusing the same
                                         IconGlyph the tile view already derives from MIME/extension so the
                                         two views stay consistent (image/video/audio/archive/document). -->
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource IconFont}" Text="{Binding IconGlyph}"
                                                           FontSize="16" VerticalAlignment="Center" Margin="0,0,9,0"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="Size" Width="110"
                                                DisplayMemberBinding="{Binding SizeDisplay}" />
                                <GridViewColumn Header="Uploaded" Width="180"
                                                DisplayMemberBinding="{Binding UploadedDisplay}" />
                                <GridViewColumn Header="Destination" Width="180"
                                                DisplayMemberBinding="{Binding Destination}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                    <!-- Large-icon grid view (default), like Explorer's large icons -->
                    <ListView x:Name="FileGridView" Visibility="Collapsed"
                              BorderThickness="0" Background="Transparent" Padding="8"
                              SelectionMode="Extended"
                              SelectionChanged="FileListView_SelectionChanged"
                              PreviewMouseRightButtonDown="FileView_PreviewMouseRightButtonDown"
                              ContextMenu="{StaticResource FileAreaContextMenu}"
                              ItemsPanel="{StaticResource FileTilePanel}"
                              ItemTemplate="{StaticResource FileTileTemplate}"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListView.ItemContainerStyle>
                            <!-- Preserve the tile look (FileTileContainer) and add the per-file menu. -->
                            <Style TargetType="ListViewItem" BasedOn="{StaticResource FileTileContainer}">
                                <Setter Property="ContextMenu" Value="{StaticResource FileItemContextMenu}" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <!-- Drop-to-upload hint: only shown while external files are dragged over this area.
                         Not hit-test visible, so it never interferes with the drop routing beneath it. -->
                    <Border x:Name="DropHintOverlay" Visibility="Collapsed" IsHitTestVisible="False"
                            Margin="10" CornerRadius="10" BorderThickness="2"
                            Background="{StaticResource AccentTintBrush}"
                            BorderBrush="{StaticResource AccentBrush}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE898;" FontSize="42"
                                       Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock x:Name="DropHintText" Text="Drop files to upload"
                                       FontSize="16" FontWeight="SemiBold" Margin="0,10,0,0"
                                       HorizontalAlignment="Center"
                                       Foreground="{StaticResource TextPrimaryBrush}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

    </DockPanel>

    <!-- Settings: a centered, fixed-size card over a dimmed scrim of the app (not a full-bleed page).
         A short settings form stretched across a maximised window looked empty; bounding it to a snug
         card with the app dimmed behind reads as a focused dialog instead. Clicking the scrim, Back,
         Close or Esc all close it (SettingsScrim_MouseDown ignores clicks on the card itself). -->
    <Grid x:Name="SettingsPage" Visibility="Collapsed"
          Background="{StaticResource ScrimBrush}"
          MouseLeftButtonDown="SettingsScrim_MouseDown">
        <!-- Fixed-size centered card. The drop-shadow lives on a dedicated background Border with no
             content, so the card's text/icons are never routed through the shadow's render pipeline
             (keeps them pixel-crisp on high-DPI displays). PerMonitorV2 DPI awareness (app.manifest)
             is what stops the whole page from being bitmap-upscaled by Windows. -->
        <Grid Width="860" Height="560" HorizontalAlignment="Center" VerticalAlignment="Center"
              SnapsToDevicePixels="True" UseLayoutRounding="True">
            <Border Background="{StaticResource WindowBgBrush}" CornerRadius="12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.32" Color="#000000" />
                </Border.Effect>
            </Border>
            <Border Background="{StaticResource WindowBgBrush}" CornerRadius="12"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="1">
        <DockPanel>
            <!-- Page header: Back · title · Close -->
            <Border DockPanel.Dock="Top" Background="{StaticResource StripBrush}"
                    BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1"
                    CornerRadius="11,11,0,0" Padding="12,10">
                <DockPanel LastChildFill="False">
                    <Button x:Name="SettingsBackButton" DockPanel.Dock="Left"
                            Style="{StaticResource ToolbarButton}" MinHeight="0" Padding="8,4"
                            Click="CloseSettingsPanel_Click" ToolTip="Back to files">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE76B;" FontSize="16" />
                    </Button>
                    <TextBlock Text="Settings" DockPanel.Dock="Left" VerticalAlignment="Center"
                               Margin="10,0,0,0" FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Button x:Name="CloseSettingsButton" DockPanel.Dock="Right"
                            Style="{StaticResource ToolbarButton}" MinHeight="0" Padding="6,2"
                            Click="CloseSettingsPanel_Click" ToolTip="Close (Esc)">
                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE711;" FontSize="12" />
                    </Button>
                </DockPanel>
            </Border>

            <!-- Body: category rail (left) + selected section (right), filling the card. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ListBox x:Name="SettingsRail" Grid.Column="0" BorderThickness="0"
                         Background="Transparent" Padding="8,12"
                         ItemContainerStyle="{StaticResource NavItemContainer}"
                         SelectionChanged="SettingsRail_SelectionChanged">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE80F;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Upload destination" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE77B;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Saved Messages" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE8B7;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Storage" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE77B;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Account" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE946;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="About" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE895;" Margin="0,0,12,0"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Updates" VerticalAlignment="Center" />
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>

                <Border Grid.Column="1" BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28,24" HorizontalAlignment="Stretch">
                            <!-- Upload destination -->
                            <StackPanel x:Name="SecDestination">
                                <TextBlock Text="Upload destination" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,10"
                                           Text="Where new uploads go by default." />
                                <RadioButton x:Name="SavedMessagesRadio" GroupName="Destination"
                                             Margin="0,2" Checked="DestinationRadio_Checked"
                                             Content="Saved Messages (your own account — always available)" />
                                <RadioButton x:Name="GroupRadio" GroupName="Destination"
                                             Margin="0,2" Checked="DestinationRadio_Checked" />
                                <TextBlock x:Name="NoGroupNote" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="22,2,0,0" TextWrapping="Wrap"
                                           Visibility="Collapsed"
                                           Text="No private group exists on this account yet. Create one below to choose it here." />
                                <Button x:Name="CreateGroupButton" Style="{StaticResource ToolbarButton}"
                                        IsEnabled="False" HorizontalAlignment="Left" Margin="0,12,0,0"
                                        Click="CreateGroupButton_Click"
                                        ToolTip="Create one private storage group on your own account. You are its only member — no one is invited and no contacts are read.">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconFont}" Text="&#xE710;" Margin="0,0,7,0" />
                                        <TextBlock Text="Create private group" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Saved Messages -->
                            <StackPanel x:Name="SecSaved" Visibility="Collapsed">
                                <TextBlock Text="Saved Messages" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,10"
                                           Text="Saved Messages normally shows only the files you added through Nuvia. Turn this on to also list files you sent to Saved Messages from Telegram itself. Your private storage group always shows every file, whatever added it." />
                                <CheckBox x:Name="ShowExternalFilesCheck" Margin="0,2" IsEnabled="False"
                                          Click="ShowExternalFilesToggle_Click"
                                          Content="Also show files added outside Nuvia" />
                                <TextBlock Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="11" Margin="22,4,0,0" TextWrapping="Wrap"
                                           Text="This only changes what Nuvia lists on this PC. Turning it off forgets those files locally — it never uploads, deletes or edits anything in Telegram." />
                            </StackPanel>

                            <!-- Storage -->
                            <StackPanel x:Name="SecData" Visibility="Collapsed">
                                <TextBlock Text="Storage" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,14"
                                           Text="Nuvia keeps a small amount of data on this PC: a local index of the files you uploaded and a cache of preview thumbnails. None of it is a copy of your Telegram files — the files themselves live in your Telegram account." />

                                <!-- On-disk sizes -->
                                <Border Background="{StaticResource AccentTintBrush}" Padding="14,12" CornerRadius="6"
                                        BorderBrush="{StaticResource RowSelectedBorderBrush}" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="File index" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                            <TextBlock Text="Preview cache" FontSize="12" FontWeight="SemiBold"
                                                       Margin="0,6,0,0"
                                                       Foreground="{StaticResource TextPrimaryBrush}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                            <TextBlock x:Name="StorageIndexSizeText" Text="…" FontSize="12"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                            <TextBlock x:Name="StorageCacheSizeText" Text="…" FontSize="12"
                                                       Margin="0,6,0,0" HorizontalAlignment="Right"
                                                       Foreground="{StaticResource TextSecondaryBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="StorageOpenFolderButton" Style="{StaticResource ToolbarButton}"
                                            Click="StorageOpenFolder_Click"
                                            ToolTip="Open the Nuvia data folder in File Explorer.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE8B7;" Margin="0,0,7,0" />
                                            <TextBlock Text="Open data folder" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="StorageClearCacheButton" Style="{StaticResource ToolbarButton}"
                                            Margin="8,0,0,0" Click="StorageClearCache_Click"
                                            ToolTip="Delete the cached preview thumbnails. They are rebuilt automatically as you browse — nothing in Telegram is touched.">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE74D;" Margin="0,0,7,0" />
                                            <TextBlock Text="Clear preview cache" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- Reset the local index (recoverable) -->
                                <Border Background="{StaticResource AccentTintBrush}" Padding="14,12" CornerRadius="6"
                                        BorderBrush="{StaticResource RowSelectedBorderBrush}" BorderThickness="1"
                                        Margin="0,18,0,0">
                                    <StackPanel>
                                        <TextBlock Text="Reset the local file list" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18" Margin="0,4,0,0"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   Text="Forgets the local index and rebuilds it from your Telegram account. Files you uploaded through Nuvia come back automatically. Local-only details do not: custom names you gave files, and the folders you placed files added outside Nuvia into. Nothing in Telegram is deleted." />
                                        <Button x:Name="StorageResetIndexButton" Style="{StaticResource SecondaryButton}"
                                                HorizontalAlignment="Left" Margin="0,12,0,0"
                                                Click="StorageResetIndex_Click"
                                                Content="Reset and rebuild from Telegram" />
                                        <TextBlock x:Name="StorageResetStatusText" TextWrapping="Wrap" FontSize="12"
                                                   Margin="0,10,0,0" Visibility="Collapsed"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Account -->
                            <StackPanel x:Name="SecAccount" Visibility="Collapsed">
                                <TextBlock Text="Account" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,14"
                                           Text="You are signed in to your own Telegram account. Nuvia only ever touches this account — it never reads your chats, contacts or messages beyond the files you store here." />

                                <Border Background="{StaticResource AccentTintBrush}" Padding="14,12" CornerRadius="6"
                                        BorderBrush="{StaticResource RowSelectedBorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconFont}" Text="&#xE77B;" FontSize="16"
                                                       VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Foreground="{StaticResource AccentBrush}" />
                                            <TextBlock x:Name="AccountStateText" FontSize="13" FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="Signed in" />
                                        </StackPanel>
                                        <TextBlock x:Name="AccountDestinationText" FontSize="12" Margin="24,4,0,0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{StaticResource TextSecondaryBrush}"
                                                   Text="New uploads go to Saved Messages." />
                                    </StackPanel>
                                </Border>

                                <Button x:Name="SettingsLogoutButton" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0"
                                        Click="SettingsLogout_Click"
                                        ToolTip="Sign out of this account on this PC."
                                        Content="Log out" />
                                <TextBlock FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Logging out clears the saved session on this PC. Your files and the data stored in Telegram are left untouched." />
                            </StackPanel>

                            <!-- About -->
                            <StackPanel x:Name="SecAbout" Visibility="Collapsed">
                                <!-- Brand banner: logo tile + Segoe Script wordmark + tagline + version -->
                                <Border CornerRadius="12" Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource RowSelectedBorderBrush}" BorderThickness="1"
                                        ClipToBounds="True">
                                    <StackPanel>
                                        <Border Height="8" Background="{StaticResource BrandPanelBrush}" />
                                        <StackPanel Margin="22,20,22,20">
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="60" Height="60" CornerRadius="14"
                                                        Background="{StaticResource AccentTintBrush}">
                                                    <Image Source="{StaticResource NuviaLogoImage}" Width="42" Height="42"
                                                           RenderOptions.BitmapScalingMode="HighQuality" />
                                                </Border>
                                                <StackPanel VerticalAlignment="Center" Margin="16,0,0,0">
                                                    <TextBlock Text="nuvia" FontFamily="Segoe Script" FontSize="42"
                                                               Foreground="{StaticResource WordmarkBrush}" />
                                                    <TextBlock Text="The cloud that never fills up." FontSize="13"
                                                               Margin="2,-2,0,0"
                                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                            <TextBlock FontSize="12" Margin="0,16,0,0"
                                                       Foreground="{StaticResource TextSecondaryBrush}">
                                                <Run Text="Version " /><Run Text="{x:Static local:AppInfo.VersionDisplay}" />
                                                <Run Text="  ·  Built with .NET 8 · WPF · WTelegramClient" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Background="{StaticResource AccentTintBrush}" Padding="14,12" CornerRadius="6"
                                        BorderBrush="{StaticResource RowSelectedBorderBrush}" BorderThickness="1"
                                        Margin="0,16,0,0">
                                    <TextBlock TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               Text="Nuvia is an unofficial local app. It uses the Telegram API and is not affiliated with Telegram. Files you store are sent to your own Telegram account." />
                                </Border>

                                <!-- Opens the support chat in Telegram (default handler). Hidden until a
                                     support handle is set in AppInfo; the code-behind sets its Tag + shows it. -->
                                <Button x:Name="ContactSupportButton" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,16,0,0" Visibility="Collapsed"
                                        Click="NotificationAction_Click"
                                        Content="Contact support" />
                            </StackPanel>

                            <!-- Updates -->
                            <StackPanel x:Name="SecUpdates" Visibility="Collapsed">
                                <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,4" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}"
                                           FontSize="12" Margin="0,0,0,12"
                                           Text="Nuvia can check for a newer version in the background. The check is a single outbound request that sends only the app name and version — never your account, files or phone number — and Nuvia never installs anything by itself." />

                                <TextBlock FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Current version: " /><Run Text="{x:Static local:AppInfo.VersionDisplay}" />
                                </TextBlock>
                                <TextBlock x:Name="LastCheckedText" FontSize="12" Margin="0,2,0,12"
                                           Foreground="{StaticResource TextSecondaryBrush}"
                                           Text="Last checked: never" />

                                <CheckBox x:Name="AutoCheckUpdatesCheck" Margin="0,2"
                                          Click="AutoCheckUpdatesToggle_Click"
                                          Content="Automatically check for updates" />

                                <Button x:Name="CheckUpdatesNowButton" Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Left" Margin="0,14,0,0"
                                        Click="CheckUpdatesNow_Click"
                                        Content="Check for updates now" />

                                <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" FontSize="12"
                                           Margin="0,12,0,0" Visibility="Collapsed"
                                           Foreground="{StaticResource TextPrimaryBrush}" />
                                <Button x:Name="UpdateDownloadLink" Style="{StaticResource LinkButton}"
                                        HorizontalAlignment="Left" Margin="0,6,0,0"
                                        Visibility="Collapsed"
                                        Content="Open download page"
                                        Click="NotificationAction_Click" />
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Border>
            </Grid>
        </DockPanel>
            </Border>
        </Grid>
    </Grid>

    </Grid>

</Window>
