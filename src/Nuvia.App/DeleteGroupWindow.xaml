<Window x:Class="Nuvia.App.DeleteGroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete storage group"
        Width="470"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <StackPanel Margin="20">
        <TextBlock x:Name="HeaderText"
                   Text="Delete this storage group"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Margin="0,0,0,8"
                   Foreground="{StaticResource DangerTextBrush}"
                   TextWrapping="Wrap" />
        <TextBlock x:Name="IntroText"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,12"
                   Text="This permanently deletes the private group from your Telegram account, along with every file stored in it. This cannot be undone. Files kept in Saved Messages are not affected." />

        <TextBlock x:Name="ScopeNote"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   FontSize="12"
                   Margin="0,0,0,14"
                   Visibility="Collapsed" />

        <CheckBox x:Name="ConfirmCheck"
                  Content="I understand this permanently deletes the group and its files."
                  Foreground="{StaticResource TextPrimaryBrush}"
                  Checked="ConfirmCheck_Changed"
                  Unchecked="ConfirmCheck_Changed" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,18,0,0">
            <Button x:Name="CancelButton"
                    Content="Cancel"
                    IsCancel="True"
                    IsDefault="True"
                    Style="{StaticResource SecondaryButton}"
                    MinWidth="96"
                    Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="DeleteButton"
                    Content="Delete group"
                    IsEnabled="False"
                    Style="{StaticResource DangerButton}"
                    MinWidth="96"
                    Click="DeleteButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
