<Window x:Class="Nuvia.App.LogoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Log out"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}">
    <!-- Nuvia-themed logout confirmation. Mirrors DeleteFileWindow: collects a yes/no choice only,
         never touches Telegram or the session itself; the caller acts on ShowDialog() == true.
         Default focus sits on Cancel so a stray Enter can never sign the user out. -->
    <StackPanel Margin="22,20">
        <TextBlock Text="Log out of Nuvia?"
                   FontSize="16" FontWeight="SemiBold"
                   Margin="0,0,0,8"
                   Foreground="{StaticResource TextPrimaryBrush}"
                   TextWrapping="Wrap" />

        <TextBlock TextWrapping="Wrap" FontSize="12.5" Margin="0,0,0,12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Text="Log out of Nuvia and delete the local session from this PC? You will return to the sign-in screen." />

        <Border Background="{StaticResource StripBrush}" CornerRadius="8" Padding="14,10">
            <StackPanel>
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="&#8226;  This session will be revoked on Telegram when you are online." />
                <TextBlock TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="&#8226;  Your Telegram messages, files, groups and account are NOT deleted." />
                <TextBlock TextWrapping="Wrap" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Text="&#8226;  Nuvia's local file index is NOT deleted." />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True"
                    Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0"
                    Click="CancelButton_Click" />
            <Button x:Name="LogoutButton" Content="Log out"
                    Style="{StaticResource PrimaryButton}" MinWidth="96"
                    Click="LogoutButton_Click" />
        </StackPanel>
    </StackPanel>
</Window>
